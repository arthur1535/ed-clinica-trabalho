{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compilar_clinica",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-g",
                "clinica.c",
                "fila.c",
                "pilha.c",
                "lista_circular.c",
                "lista_com_cabeca.c",
                "-o",
                "clinica.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/fila_pilha"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Executar Clinica no Terminal",
            "type": "shell",
            "command": ".\\clinica.exe",
            "options": {
                "cwd": "${workspaceFolder}/fila_pilha"
            },
            "dependsOn": "compilar_clinica",
            "problemMatcher": [],
            "presentation": {
                "focus": true,
                "panel": "shared",
                "reveal": "always"
            }
        },
        {
            "label": "compilar_aula02",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-g",
                "-O0",
                "lista_circular.c",
                "main.c",
                "-o",
                "main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/lista_circular_aula"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Executar Lista Circular Aula 02",
            "type": "shell",
            "command": ".\\main.exe",
            "options": {
                "cwd": "${workspaceFolder}/lista_circular_aula"
            },
            "dependsOn": "compilar_aula02",
            "problemMatcher": [],
            "presentation": {
                "focus": true,
                "panel": "shared",
                "reveal": "always"
            }
        },
        {
            "label": "compilar_exemplo_fila",
            "type": "shell",
